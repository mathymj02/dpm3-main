    <style>
        .seolife-drive-slider-widget .swiper-slide {
            cursor: pointer;
        }

        .seolife-drive-lightbox {
            position: fixed;
            inset: 0;
            z-index: 999999;
            background: rgba(0, 0, 0, 0.94);
            display: none;
            align-items: center;
            justify-content: center;
        }

        .seolife-drive-lightbox.is-active {
            display: flex;
        }

        .seolife-drive-lightbox-inner {
            width: 100%;
            height: 100%;
            position: relative;
            padding: 60px 80px;
            box-sizing: border-box;
        }

        .seolife-drive-lightbox-swiper {
            width: 100%;
            height: 100%;
        }

        .seolife-drive-lightbox .swiper-slide {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .seolife-drive-lightbox img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            display: block;
            border-radius: 12px;
            user-select: none;
        }

        .seolife-drive-lightbox-close {
            position: absolute;
            top: 20px;
            right: 24px;
            z-index: 30;
            width: 46px;
            height: 46px;
            border: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.15);
            color: #fff;
            font-size: 32px;
            line-height: 1;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .seolife-drive-lightbox-close:hover {
            background: rgba(255, 255, 255, 0.25);
        }

        .seolife-drive-lightbox-prev,
        .seolife-drive-lightbox-next {
            color: #fff;
            width: 54px;
            height: 54px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.14);
        }

        .seolife-drive-lightbox-prev::after,
        .seolife-drive-lightbox-next::after {
            font-size: 28px;
            font-weight: 700;
        }

        .seolife-drive-lightbox-pagination {
            bottom: 22px !important;
        }

        .seolife-drive-lightbox-pagination .swiper-pagination-bullet {
            background: #fff;
            opacity: 0.35;
        }

        .seolife-drive-lightbox-pagination .swiper-pagination-bullet-active {
            opacity: 1;
        }

        body.seolife-drive-lightbox-open {
            overflow: hidden;
        }

        @media (max-width: 767px) {
            .seolife-drive-lightbox-inner {
                padding: 60px 18px 55px;
            }

            .seolife-drive-lightbox-close {
                top: 14px;
                right: 14px;
                width: 40px;
                height: 40px;
                font-size: 28px;
            }

            .seolife-drive-lightbox-prev,
            .seolife-drive-lightbox-next {
                width: 38px;
                height: 38px;
                background: rgba(255, 255, 255, 0.18);
            }

            .seolife-drive-lightbox-prev::after,
            .seolife-drive-lightbox-next::after {
                font-size: 18px;
            }

            .seolife-drive-lightbox img {
                border-radius: 8px;
            }
        }
    </style>

    <script>
    (function() {
        const LIGHTBOX_IMAGE_WIDTH = 1800;

        let lightbox = null;
        let lightboxSwiper = null;

        function getDriveFileIdFromUrl(url) {
            if (!url) return '';

            try {
                const parsed = new URL(url);

                const idParam = parsed.searchParams.get('id');
                if (idParam) return idParam;

                const fileMatch = url.match(/\/file\/d\/([^/]+)/);
                if (fileMatch && fileMatch[1]) return fileMatch[1];

                const filesMatch = url.match(/\/files\/([^?]+)/);
                if (filesMatch && filesMatch[1]) return decodeURIComponent(filesMatch[1]);

            } catch (e) {}

            return '';
        }

        function getHighResDriveImage(fileId) {
            return 'https://drive.google.com/thumbnail?id=' + encodeURIComponent(fileId) + '&sz=w' + LIGHTBOX_IMAGE_WIDTH;
        }

        function createLightbox() {
            if (lightbox) return lightbox;

            lightbox = document.createElement('div');
            lightbox.className = 'seolife-drive-lightbox';
            lightbox.innerHTML = `
                <div class="seolife-drive-lightbox-inner">
                    <button type="button" class="seolife-drive-lightbox-close" aria-label="Cerrar">×</button>

                    <div class="swiper seolife-drive-lightbox-swiper">
                        <div class="swiper-wrapper"></div>

                        <div class="swiper-button-prev seolife-drive-lightbox-prev"></div>
                        <div class="swiper-button-next seolife-drive-lightbox-next"></div>
                        <div class="swiper-pagination seolife-drive-lightbox-pagination"></div>
                    </div>
                </div>
            `;

            document.body.appendChild(lightbox);

            lightbox.querySelector('.seolife-drive-lightbox-close').addEventListener('click', closeLightbox);

            lightbox.addEventListener('click', function(e) {
                if (e.target === lightbox) {
                    closeLightbox();
                }
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && lightbox.classList.contains('is-active')) {
                    closeLightbox();
                }
            });

            return lightbox;
        }

        function closeLightbox() {
            if (!lightbox) return;

            lightbox.classList.remove('is-active');
            document.body.classList.remove('seolife-drive-lightbox-open');

            if (lightboxSwiper) {
                lightboxSwiper.destroy(true, true);
                lightboxSwiper = null;
            }

            const wrapper = lightbox.querySelector('.swiper-wrapper');
            if (wrapper) {
                wrapper.innerHTML = '';
            }
        }

        function collectImagesFromWidget(widget) {
            const images = [];
            const usedIds = {};

            const slideImages = widget.querySelectorAll('.swiper-slide img');

            slideImages.forEach(function(img) {
                const rawUrl = img.dataset.src || img.currentSrc || img.src || '';
                const fileId = getDriveFileIdFromUrl(rawUrl);

                if (!fileId || usedIds[fileId]) return;

                usedIds[fileId] = true;

                images.push({
                    id: fileId,
                    alt: img.alt || ''
                });
            });

            return images;
        }

        function openLightbox(widget, clickedImg) {
            if (typeof Swiper === 'undefined') {
                console.warn('Swiper no está disponible para el lightbox.');
                return;
            }

            const images = collectImagesFromWidget(widget);

            if (!images.length) return;

            const clickedUrl = clickedImg.dataset.src || clickedImg.currentSrc || clickedImg.src || '';
            const clickedId = getDriveFileIdFromUrl(clickedUrl);

            let initialIndex = images.findIndex(function(item) {
                return item.id === clickedId;
            });

            if (initialIndex < 0) {
                initialIndex = 0;
            }

            createLightbox();

            const wrapper = lightbox.querySelector('.swiper-wrapper');
            wrapper.innerHTML = '';

            images.forEach(function(item) {
                const slide = document.createElement('div');
                slide.className = 'swiper-slide';

                const image = document.createElement('img');
                image.src = getHighResDriveImage(item.id);
                image.alt = item.alt;
                image.loading = 'lazy';
                image.decoding = 'async';

                slide.appendChild(image);
                wrapper.appendChild(slide);
            });

            lightbox.classList.add('is-active');
            document.body.classList.add('seolife-drive-lightbox-open');

            lightboxSwiper = new Swiper(lightbox.querySelector('.seolife-drive-lightbox-swiper'), {
                slidesPerView: 1,
                spaceBetween: 30,
                initialSlide: initialIndex,
                speed: 450,
                grabCursor: true,
                keyboard: {
                    enabled: true
                },
                navigation: {
                    nextEl: lightbox.querySelector('.seolife-drive-lightbox-next'),
                    prevEl: lightbox.querySelector('.seolife-drive-lightbox-prev')
                },
                pagination: {
                    el: lightbox.querySelector('.seolife-drive-lightbox-pagination'),
                    clickable: true
                }
            });
        }

        document.addEventListener('click', function(e) {
            const img = e.target.closest('.seolife-drive-slider-widget .swiper-slide img');

            if (!img) return;

            const widget = img.closest('.seolife-drive-slider-widget');

            if (!widget) return;

            e.preventDefault();

            openLightbox(widget, img);
        });
    })();
    </script>
    
</body>
</html>
